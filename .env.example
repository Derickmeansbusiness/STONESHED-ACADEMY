# Stoneshed Academy — environment configuration
# Copy to .env.local and fill in values. Nothing here is required for the local demo.

# Database (SQLite file by default; libsql/Turso URL or a Postgres migration for production)
DATABASE_URL="file:./data/academy.db"

# Session signing secret (32+ random characters). A development fallback is used if unset.
AUTH_SECRET=""

# Ask Stoneshed AI — the tutor runs in grounded offline mode until a key is provided.
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"

# Public site URL used for certificate verification links and QR codes
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Email (not connected in Phase One — the app records notifications in the outbox table instead)
RESEND_API_KEY=""
